use xero::math

struct vec2 {
    x: f64;
    y: f64;

    fn @print() {
        print("(");
        print(self.x);
        print(", ");
        print(self.y);
        print(")");
    }

    # Arithmetic

    fn @plus(v: vec2)  -> vec2 {
        return vec2 { x = self.x + v.x, y = self.y + v.y };
    }
    fn @minus(v: vec2) -> vec2 {
        return vec2 { x = self.x - v.x, y = self.y - v.y };
    }
    fn @star(s: f64)   -> vec2 {
        return vec2 { x = self.x * s, y = self.y * s };
    }
    fn @slash(s: f64)  -> vec2 {
        return vec2 { x = self.x / s, y = self.y / s };
    }
    fn @neg()          -> vec2 {
        return vec2 { x = -self.x, y = -self.y };
    }

    # Comparison

    fn @eq(v: vec2)  -> bool {
        return self.x == v.x && self.y == v.y;
    }
    fn @neq(v: vec2) -> bool {
        return !(self == v);
    }

    # Componentwise
    fn min(v: vec2)            -> vec2 {
        return vec2 { x = min(self.x, v.x), y = min(self.y, v.y) };
    }
    fn max(v: vec2)            -> vec2 {
        return vec2 { x = max(self.x, v.x), y = max(self.y, v.y) };
    }
    fn clamp(l: vec2, h: vec2) -> vec2 {
        return vec2 { x = clamp(self.x, l.x, h.x), y = clamp(self.y, l.y, h.y) };
    }
    fn abs()                   -> vec2 {
        return vec2 { x = abs(self.x), y = abs(self.y) };
    }
    fn floor()                 -> vec2 {
        return vec2 { x = floor(self.x), y = floor(self.y) };
    }
    fn ceil()                  -> vec2 {
        return vec2 { x = ceil(self.x), y = ceil(self.y) };
    }
    fn round()                 -> vec2 {
        return vec2 { x = round(self.x), y = round(self.y) };
    }

    # Measurement
    
    fn length_squared()          -> f64 {
        return self.x * self.x + self.y * self.y;
    }
    fn length()                  -> f64 {
        return sqrt(self.length_squared());
    }
    fn distance_squared(v: vec2) -> f64 {
        dx: f64 = self.x - v.x;
        dy: f64 = self.y - v.y;
        return dx * dx + dy * dy;
    }
    fn distance(v: vec2)         -> f64 {
        return sqrt(self.distance_squared(v));
    }

    fn length_manhattan()          -> f64 {
        return abs(self.x) + abs(self.y);
    }
    fn distance_manhattan(v: vec2) -> f64 {
        return abs(self.x - v.x) + abs(self.y - v.y);
    }

    # Direction

    fn normalized() -> vec2 {
        len: f64 = self.length();
        if (len < eps) {
            return vec2 { x = 0.0, y = 0.0 };
        }
        return vec2 { x = self.x / len, y = self.y / len };
    }
    fn normalize() {
        self = self.normalized();
    }

    # Product

    fn dot(v: vec2)   -> f64 {
        return self.x * v.x + self.y * v.y;
    }
    fn cross(v: vec2) -> f64 {
        return self.x * v.y - self.y * v.x;
    }

    # Geometry

    fn project(v: vec2) -> vec2 {
        len2: f64 = v.length_squared();
        if (len2 < eps2) {
            return vec2 { x = 0.0, y = 0.0 };
        }
        return v * (self.dot(v) / len2);
    }
    fn reflect(n: vec2) -> vec2 {
        n = n.normalized();
        return self - n * (2.0 * self.dot(n));
    }

    # Similarity

    fn cosine(v: vec2) -> f64 {
        len_a: f64 = self.length();
        len_b: f64 = v.length();
        if (len_a < eps || len_b < eps) {
            return 0.0;
        }
        return self.dot(v) / (len_a * len_b);
    }
}
