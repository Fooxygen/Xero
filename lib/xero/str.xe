# Find

fn find_first(s: string&, pat: string&) -> i64 {
    if (is_empty(pat))       return 0;
    if (pat.len() > s.len()) return -1;

    for (i in 0..=(s.len() - pat.len())) {
        is_match: bool = true;
        for (j in 0..pat.len()) {
            if (s[i + j] != pat[j]) { is_match = false; break; }
        }
        if (is_match) return i;
    }
    return -1;
}
fn find_first(s: string,  pat: string)  -> i64 { return find_first(&s, &pat); }

fn find_last(s: string&,  pat: string&) -> i64 {
    if (is_empty(pat))       return s.len();
    if (pat.len() > s.len()) return -1;

    for (i in (s.len() - pat.len())..-1..(-1)) {
        is_match: bool = true;
        for (j in 0..pat.len()) {
            if (s[i + j] != pat[j]) { is_match = false; break; }
        }
        if (is_match) return i;
    }
    return -1;
}
fn find_last(s: string,   pat: string)  -> i64 { return find_last(&s, &pat); }

fn find_first_in(s: string&, chars: string) -> i64 {
    for (i in 0..s.len()) {
        c: char = s[i];

        for (j in 0..chars.len()) {
            if (c == chars[j]) return i;
        }
    }
    return -1;
}
fn find_first_in(s: string,  chars: string) -> i64 { return find_first_in(&s, chars); }

fn find_first_out(s: string&, chars: string) -> i64 {
    for (i in 0..s.len()) {
        c: char = s[i];
        is_in: bool = false;

        for (j in 0..chars.len()) {
            if (c == chars[j]) { is_in = true; break; }
        }
        if (!is_in) return i;
    }
    return -1;
}
fn find_first_out(s: string,  chars: string) -> i64 { return find_first_out(&s, chars); }

fn find_last_in(s: string&, chars: string) -> i64 {
    if (s.len() == 0) return -1;

    for (i in (s.len() - 1)..-1..(-1)) {
        c: char = s[i];

        for (j in 0..chars.len()) {
            if (c == chars[j]) return i;
        }
    }
    return -1;
}
fn find_last_in(s: string,  chars: string) -> i64 { return find_last_in(&s, chars); }

fn find_last_out(s: string&, chars: string) -> i64 {
    if (s.len() == 0) return -1;

    for (i in (s.len() - 1)..-1..(-1)) {
        c: char = s[i];
        is_in: bool = false;

        for (j in 0..chars.len()) {
            if (c == chars[j]) { is_in = true; break; }
        }
        if (!is_in) return i;
    }
    return -1;
}
fn find_last_out(s: string,  chars: string) -> i64 { return find_last_out(&s, chars); }

# Predicate

fn is_empty(s: string&) -> bool { return s.len() == 0; }
fn is_empty(s: string)  -> bool { return is_empty(&s); }

fn has(s: string&, pat: string&) -> bool { return find_first(s, pat) >= 0; }
fn has(s: string,  pat: string)  -> bool { return has(&s, &pat); }

fn has_prefix(s: string&, pre: string&) -> bool { return find_first(s, pre) == 0; }
fn has_prefix(s: string,  pre: string)  -> bool { return has_prefix(&s, &pre); }

fn has_suffix(s: string&, suf: string&) -> bool {
    if (suf.len() > s.len()) return false;
    return find_last(s, suf) == s.len() - suf.len();
}
fn has_suffix(s: string,  suf: string)  -> bool { return has_suffix(&s, &suf); }

# Take

fn take_prefix(s: string&, len: i64) -> string {
    if (len <= 0)       return "";
    if (len >= s.len()) return s;
    return s[0..len];
}
fn take_prefix(s: string,  len: i64) -> string { return take_prefix(&s, len); }

fn take_suffix(s: string&, len: i64) -> string {
    if (len <= 0)       return "";
    if (len >= s.len()) return s;
    return s[(s.len() - len)..s.len()];
}
fn take_suffix(s: string,  len: i64) -> string { return take_suffix(&s, len); }

