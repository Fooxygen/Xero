# Trim

fn trim_start(s: string&, chars: string) -> string {
    i: i64 = find_first_out(s, chars);
    if (i < 0) return "";
    return s[i..s.len()];
}
fn trim_start(s: string, chars: string) -> string { return trim_start(&s, chars); }
fn trim_start(s: string&) -> string { return trim_start(s, " \t\n\r"); }
fn trim_start(s: string)  -> string { return trim_start(&s, " \t\n\r"); }

fn trim_end(s: string&, chars: string) -> string {
    i: i64 = find_last_out(s, chars);
    if (i < 0) return "";
    return s[0..=i];
}
fn trim_end(s: string, chars: string) -> string { return trim_end(&s, chars); }
fn trim_end(s: string&) -> string { return trim_end(s, " \t\n\r"); }
fn trim_end(s: string)  -> string { return trim_end(&s, " \t\n\r"); }

fn trim(s: string&, chars: string) -> string {
    l: i64 = find_first_out(s, chars);
    if (l < 0) return "";
    r: i64 = find_last_out(s, chars);
    return s[l..=r];
}
fn trim(s: string, chars: string) -> string { return trim(&s, chars); }
fn trim(s: string&) -> string { return trim(s, " \t\n\r"); }
fn trim(s: string)  -> string { return trim(&s, " \t\n\r"); }

# Join

fn join(parts: array[=string=]&, sep: string) -> string {
    result: string = "";
    for (i in 0..parts.len()) {
        if (i > 0) result += sep;
        result += parts[i];
    }
    return result;
}
fn join(parts: array[=string=], sep: string) -> string { return join(&parts, sep); }

# Split

fn split(s: string&, sep: char) -> array[=string=] {
    result: array[=string=] = [];
    offset: i64 = 0;

    for (i in 0..s.len()) {
        if (s[i] == sep) {
            result.push_back(s[offset..i]);
            offset = i + 1;
        }
    }
    result.push_back(s[offset..s.len()]);
    
    return result;
}
fn split(s: string, sep: char) -> array[=string=] { return split(&s, sep); }
