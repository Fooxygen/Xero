fn abs(x: i32) -> i32 { if (x < 0) { return -x; } return x; }
fn abs(x: i64) -> i64 { if (x < 0) { return -x; } return x; }

fn min(a: i32, b: i32) -> i32 { if (a < b) { return a; } return b; }
fn min(a: i64, b: i64) -> i64 { if (a < b) { return a; } return b; }

fn max(a: i32, b: i32) -> i32 { if (a < b) { return b; } return a; }
fn max(a: i64, b: i64) -> i64 { if (a < b) { return b; } return a; }

fn clamp(x: i32, l: i32, h: i32) -> i32 {
    if (x < l) return l;
    if (x > h) return h;
    return x;
}
fn clamp(x: i64, l: i64, h: i64) -> i64 {
    if (x < l) return l;
    if (x > h) return h;
    return x;
}

# Round toward zero
fn trunc(x: f32) -> f32 { return x - (x % 1.0); }   # x % 1.0  = x - trunc(x)
fn trunc(x: f64) -> f64 { return x - (x % 1.0); }

# Round down
fn floor(x: f32) -> f32 { return x - (x %% 1.0); }  # x %% 1.0 = x - floor(x)
fn floor(x: f64) -> f64 { return x - (x %% 1.0); }

# Round up
fn ceil(x: f32) -> f32 { return x + ((-x) %% 1.0); }
fn ceil(x: f64) -> f64 { return x + ((-x) %% 1.0); }

# Round to nearest
fn round(x: f32) -> f32 { return floor(x + 0.5); }
fn round(x: f64) -> f64 { return floor(x + 0.5); }

# Fractional part in [0, 1)
fn fract(x: f32) -> f32 { return x %% 1.0; }
fn fract(x: f64) -> f64 { return x %% 1.0; }

# sqrt
fn sqrt(x: f32) -> f32 { return @sqrt(x); }
fn sqrt(x: f64) -> f64 { return @sqrt(x); }

# pow
fn pow(x: f32, y: f32) -> f32 { return @pow(x, y); }
fn pow(x: f64, y: f64) -> f64 { return @pow(x, y); }

# exp
fn exp(x: f32) -> f32 { return @exp(x); }
fn exp(x: f64) -> f64 { return @exp(x); }

# ln
fn ln(x: f32) -> f32 { return @ln(x); }
fn ln(x: f64) -> f64 { return @ln(x); }

# log2
fn log2(x: f32) -> f32 { return @log2(x); }
fn log2(x: f64) -> f64 { return @log2(x); }

# log10
fn log10(x: f32) -> f32 { return @log10(x); }
fn log10(x: f64) -> f64 { return @log10(x); }

# log
fn log(x: f32, base: f32) -> f32 { return ln(x) / ln(base); }
fn log(x: f64, base: f64) -> f64 { return ln(x) / ln(base); }

# sin
fn sin(x: f32) -> f32 { return @sin(x); }
fn sin(x: f64) -> f64 { return @sin(x); }

# cos
fn cos(x: f32) -> f32 { return @cos(x); }
fn cos(x: f64) -> f64 { return @cos(x); }

# tan
fn tan(x: f32) -> f32 { return @tan(x); }
fn tan(x: f64) -> f64 { return @tan(x); }
