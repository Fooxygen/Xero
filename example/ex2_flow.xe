
# if/elif/else, while, break/continue

for (i in 1..=10) {
    if (i % 5 == 0) {
        println(i, "is a multiple of 5");
    }
    elif (i % 2 == 0) {
        println(i, "is even");
    }
    else {
        println(i, "is odd");
    }
}

n: i32 = 0;
while (n < 10) {
    n += 1;
    if (n == 3) continue;
    if (n == 7) break;
    println("n = ", n);
}

if (true && (0 == 0)) println("short-circuit && works");

##
1 is odd
2 is even
3 is odd
4 is even
5 is a multiple of 5
6 is even
7 is odd
8 is even
9 is odd
10 is a multiple of 5
n =  1
n =  2
n =  4
n =  5
n =  6
short-circuit && works
##
