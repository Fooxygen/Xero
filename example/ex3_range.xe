
# Range: ..   ..=   step

r1: range[=i32=] = 0..5;
println("0..5:");
for (i in r1) println(i);

println("0..=5:");
for (i in 0..=5) println(i);

println("0..2..10 (step 2):");
for (i in 0..2..10) println(i);

println("10..-1..-10 (decreasing):");
for (i in 10..-1..-10) println(i);

println("-5..=5:");
for (i in -5..=5) println(i);

