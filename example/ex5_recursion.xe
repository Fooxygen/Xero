
# Recursion and the function type

fn fact(n: i32) -> i32 {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

for (i in 0..=6) {
    println(i, "! =", fact(i));
}

square: function = fn (x: i32) -> i32 {
    return x * x;
};
println("square(7) =", square(7));

##
0 ! = 1
1 ! = 1
2 ! = 2
3 ! = 6
4 ! = 24
5 ! = 120
6 ! = 720
square(7) = 49
##
