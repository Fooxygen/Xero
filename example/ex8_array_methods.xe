
# Array methods and arrayview slicing

q: array[=i32=] = [0];
q.push_back(1);
q.push_back(2);
q.push_back(3);
println(q, " len = ", q.len());

q.pop_back();
q.push_front(0);
println(q);

q.insert(1, 99);
println(q);

q.remove(0);
println(q);

v: arrayview = q[0..2];
println("slice len = ", v.len());

t: array = v.to_array();
println("to_array = ", t);

##
[0, 1, 2, 3]  len =  4
[0, 0, 1, 2]
[0, 99, 0, 1, 2]
[99, 0, 1, 2]
slice len =  2
to_array =  [99, 0]
##
