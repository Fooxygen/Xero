
# Array: iteration, sum, max, type promotion

scores: array[=i32=] = [90, 80, 70, 85, 95];
println("len =", scores.len());

sum: f64 = 0;
for (x in scores) {
    sum += x;
}
println("sum =", sum);
println("avg =", sum / scores.len());

max: i32 = scores[0];
for (i in 1..scores.len()) {
    if (scores[i] > max) max = scores[i];
}
println("max =", max);

concat: array[=i32=] = scores + [1, 2];
println("concat len =", concat.len());

##
len = 5
sum = 420.000000
avg = 84.000000
max = 95
concat len = 7
##
