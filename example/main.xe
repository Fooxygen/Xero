
# use xero::math

fn main() {
    println("abs(-7)          =", xero::math::abs(-7));            # 7
    println("min(3, 9)        =", xero::math::min(3, 9));          # 3
    println("max(3, 9)        =", xero::math::max(3, 9));          # 9
    println("clamp(15, 0, 10) =", xero::math::clamp(15, 0, 10));   # 10
}
