
fn main() {
    println(1 + 2);             # 3
    println(10 / 3);            # 3
    println(10 % 3);            # 1
    println(-5 %% 3);           # 1
    println(1 < 2);             # true
    println(5000000000);        # 5000000000
    println(1.5 + 2.25);        # 3.750000
    println(1.0 < 2.0);         # true
}
