
# Parametric Type and Array Test

# Basic
a1: array[=i32=] = [1, 2, 3];
println(a1);                                            # [1, 2, 3]
println(a1.len());                                      # 3

# Empty
b1: array[=i32=] = [];
b1.push_back(1);
b1.push_back(2);
println(b1);                                            # [1, 2]

# Nested
c1: array[=array[=i32=]=] = [[1, 2], [3, 4]];
println(c1);                                            # [[1, 2], [3, 4]]
println(c1.len());                                      # 2

# Operation
d1: array[=i32=] = [1, 2];
e1: array[=i32=] = [];
println(d1 + e1);                                       # [1, 2]

# Other
fn first1(arr: array[=i32=]) -> i32 { return arr[0]; }
f1: array[=i32=] = [7, 8];
println(first1(f1));                                    # 7
g1: i32 = 3;
println(g1);                                            # 3
h1: string = "hi";
println(h1.len());                                      # 2
println(type(3));                                       # i32
fn add1(m: i32, n: i32) -> i32 { return m + n; }
println(add1(1, 2));                                    # 3

# Error

# nf1: array[=i32=] = [1.5, 2.5];                       # cannot match type 'f32' to type 'i32'
# ng1: array[=i32, f64=] = [1, 2];                      # type 'array' expects 1 type parameter(s), got 2
# nh1: array[=not_a_type=] = [1];                       # undefined type 'not_a_type'
# ni1: i32[=i32=] = 1;                                  # type 'i32' expects 0 type parameter(s), got 1
# nj1: array[=i32=][=f64=] = [1];                       # reduce failed with '3' symbols unprocessed
# nk1: array[=array[=i32=]=] = [[1.5]];                 # cannot match type 'array[=f32=]' to type 'array[=i32=]'

##
fn take1(arr: array[=i32=]) -> i32 { return 0; }        # [err] 'take1' expects (array[=i32=]), got (array[=f64=])
nl1: array[=f64=] = [1.5];
println(take1(nl1));
##
