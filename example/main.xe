
println(7 % 3);         #  1
println(7 % -3);        #  1
println(-7 % 3);        # -1
println(-7 % -3);       # -1

println(7 %% 3);        #  1
println(7 %% -3);       # -2
println(-7 %% 3);       #  2
println(-7 %% -3);      # -1

println(7.5 % 2);       #  1.500000
println(-7.5 % 2);      # -1.500000
println(7.5 % -2);      #  1.500000
println(-7.5 % -2);     # -1.500000
println(7.5 % 2.5);     #  0.000000

println(7.5 %% 2);      #  1.500000
println(-7.5 %% 2);     #  0.500000
println(7.5 %% -2);     # -0.500000
println(-7.5 %% -2);    # -1.500000

println(10.0 % 3);      #  1.000000
println(10 % 3.0);      #  1.000000
println(-10 % 3.0);     # -1.000000
println(-10.0 %% 3);    #  2.000000

println(7.5 % 0.0);     #  nan
