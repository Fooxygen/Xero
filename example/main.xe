
fn main() {
    # 1 Byte
    println('A');               # expect: A
    println('z');               # expect: z

    # 2 Bytes
    println('é');               # expect: é
    println('¢');               # expect: ¢

    # 3 Bytes
    println('你');              # expect: 你
    println('好');              # expect: 好

    # 4 Bytes
    println('🥰');              # expect: 🥰

    # Variable
    c: char = '文';
    println(c);                 # expect: 文
    d: char = 'x';
    println(d);                 # expect: x

    # Logical Operator
    println('a'  < 'b');        # expect: true
    println('中' > '文');       # expect: false
    println('A' == 'A');        # expect: true
    println('A' != 'a');        # expect: true

    # Escape Char
    print('X');
    print('\t');              
    println('e');               # expect: X    e
    println('\\');              # expect: \
    println('\'');              # expect: '
}
