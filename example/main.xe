
i: i32 = 0;
while (i < 5) {
    println(i); i += 1;
}                           # 0 1 2 3 4

j: i32 = 0;
while (true) {
    if (j == 3) break;
    j += 1;
}
println(j);                 # 3

k: i32 = 0;
while (k < 5) {
    k += 1;
    if (k == 3) continue;
    println(k);
}                           # 1 2 4 5

n: i32 = 0;
while (n < 3) n += 1;
println(n);                 # 3