
fn main() {
    s: string = "Hello Xero";

    println(s[0..5] == s[0..5]);     # true
    println(s[0..5] == s[6..10]);    # false
    println(s[0..5] != s[6..10]);    # true

    v: stringview = s[0..5];
    w: stringview = s[0..5];
    println(v == w);                 # true

    println(s[0..1] == s[0..2]);     # false
}
