
fn main() {

    a: array[=i32=] = [1, 2, 3];
    b: array[=i32=] = a;
    b.push_back(4);
    println(a);                     # [1, 2, 3]
    println(b);                     # [1, 2, 3, 4]

    c: array[=i32=] = [5, 6, 7];
    d: array[=i32=] = c;
    d.push_back(8);
    println(c);                     # [5, 6, 7]
    println(d);                     # [5, 6, 7, 8]
}
