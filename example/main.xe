
fn main() {

    a: array[=i32=] = [1, 2, 3];
    println(a);                         # [1, 2, 3]

    a.insert(1, 3);     println(a);     # [1, 3, 2, 3]
    a.remove(2);        println(a);     # [1, 3, 3]
    a.push_front(2);    println(a);     # [2, 1, 3, 3]
    a.push_back(7);     println(a);     # [2, 1, 3, 3, 7]
    a.pop_front();      println(a);     # [1, 3, 3, 7]
    a.pop_back();       println(a);     # [1, 3, 3]

    println(a.len());                   # 3
    a.clear();
    println(a.len());                   # 0
    a.push_front(1);    println(a);     # [1]
}
