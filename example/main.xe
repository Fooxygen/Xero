fn abs(x: i32) -> i32 {
    if (x < 0) return -x;
    return x;
}

fn main() {
    r: i32 = 3;

    for (x in -r..=r) {
        s: i32 = r - abs(x);
        
        for (y in 0..s) print(' ');
        print('O');

        if (x != 0) {
            for (y in 0..(2 * r + 1 - 2 * s - 2)) print(' ');
            print('O');
        }

        print('\n');
    }
}
