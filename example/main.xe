
fn main() {
    a: array[=i32=] = [1, 2, 3];
    println(-a);                     # [3, 2, 1]

    s: string = "Xero";
    println(-s);                     # oreX

    v: arrayview[=i32=] = a[0..2];
    println(-v);                     # [2, 1]

    w: stringview = s[0..2];
    println(-w);                     # eX
}
