
use xero::string

fn main() {
    println(string::has("labcabcr", "abc"));        # true
    println(string::has("labdabcr", "abc"));        # true
    println(string::has("labdabdr", "abc"));        # false

    println(string::has_prefix("abcxxx", "abc"));   # true
    println(string::has_prefix("xabcxx", "abc"));   # false

    println(string::has_suffix("xxxabc", "abc"));   # true
    println(string::has_suffix("xxabcx", "abc"));   # false

    println(string::has("", ""));                   # true
    println(string::has("xxx", ""));                # true
}
