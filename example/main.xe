
use xero::string

fn main() {
    println("[" + string::trim("  hi  ") + "]");            # [hi]
    println("[" + string::trim("   ") + "]");               # []
    println("[" + string::trim("\r\n hi \r\n") + "]");      # [hi]
    println("[" + string::trim_start("  hi  ") + "]");      # [hi  ]
    println("[" + string::trim_end("  hi  ") + "]");        # [  hi]

    println(string::trim("xxhixx", "x"));                   # hi
    println(string::trim_start("xxhixx", "x"));             # hixx
    println(string::trim_end("xxhixx", "x"));               # xxhi

    println(string::trim("abc", ""));                       # abc
    println(string::trim_start("abc", ""));                 # abc
    println(string::trim_end("abc", ""));                   # abc

    println("[" + string::trim("xxx", "x") + "]");          # []
    println("[" + string::trim_start("xxx", "x") + "]");    # []
    println("[" + string::trim_end("xxx", "x") + "]");      # []

    println(string::trim("中中文中中", "中"));              # 文
    println(string::trim_start("中中文中中", "中"));        # 文中中
    println(string::trim_end("中中文中中", "中"));          # 中中文

    s: string = "  hi  ";
    t: string = string::trim(&s);
    s[0] = 'X';
    println("[" + t + "]");                                 # [hi]
}
