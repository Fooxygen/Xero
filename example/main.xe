
fn main() {
    println("abc" == "abc");        # true
    println("abc" != "abd");        # true
    println("abc" <  "abd");        # true
    println("abc" <= "abc");        # true
    println("abd" >  "abc");        # true
    println("abc" >= "ab");         # true
    println("a"   <  "aa");         # true
    println(""    <  "a");          # true
    println("Z"   <  "a");          # true
}
