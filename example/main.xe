
fn main() {
    s: string = "Hello World";

    s[0..5] = "HELLO";
    println(s);                  # HELLO World

    s[0..5] = "Hi";
    println(s);                  # Hi World

    s[0..2] = "Hey";
    println(s);                  # Hey World

    t: string = "abc";
    s[0..3] = t[0..3];
    println(s);                  # abc World
}
