
fn main() {
    println("abs(-7)          = ", abs(-7));            # 7
    println("min(3, 9)        = ", min(3, 9));          # 3
    println("max(3, 9)        = ", max(3, 9));          # 9
    println("clamp(15, 0, 10) = ", clamp(15, 0, 10));   # 10
    println("pow(2, 10)       = ", pow(2, 10));         # 1024
    println("gcd(48, 18)      = ", gcd(48, 18));        # 6
    println("factorial(6)     = ", factorial(6));       # 720
    println("is_prime(97)     = ", is_prime(97));       # true
}
