
use xero::string

fn main() {
    a: array[=string=] = ["a"];
    a.push_back("abc");
    a.push_back("abc"[0..=1]);
    a.push_back("abc"[2]);
    println(a);                     # [a, abc, ab, c]

    s: string = "hello";
    c: array[=char=] = ['b'];
    c.push_back(s[0]);
    println(c);                     # [b, h]

    i: array[=i32=] = [1];
    i.push_back(2);
    println(i);                     # [1, 2]

    f: array[=f32=] = [1.3];
    f.push_back(2.6);
    println(f);                     # [1.300000, 2.600000]

    ss: array[=string=] = ["ab", "cd"];
    ss[0].clear();
    println(ss);                    # [, cd]

    println(string::split("Hello,Xero,and,World", ','));
}
