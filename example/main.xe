
fn test_string() {
    s: string = "Hello Xero";

    println(s);                     # Hello Xero
    println(s.len());               # 10
    println(s[0]);                  # H
    println(s[6..10]);              # Xero
    println(-s);                    # oreX olleH
    println(s + "!");               # Hello Xero!
    println(s == "Hello Xero");     # true
    println(s != "hello");          # true

    for (c in s) print(c);
    println();                      # Hello Xero

    t: string = "Bye";
    t = s;
    println(t);                     # Hello Xero
    t.clear();
    println(t.len());               # 0
}

fn test_stringview() {
    s: string     = "Hello Xero";
    v: stringview = s[6..10];

    println(v);                     # Xero
    println(v.len());               # 4
    println(v[0]);                  # X
    println(v[1..3]);               # er
    println(-v);                    # oreX
    println(v == "Xero");           # true
    println(v != "Oops");           # true

    t: string = v;
    println(t);                     # Xero

    for (c in v) print(c);
    println();                      # Xero

    a: string = "Hello Xero";
    u: stringview = a[0..5];
    u = "Wow";
    println(a);                     # Wow Xero

    b: string = "Hello Xero";
    w: stringview = b[0..5];
    w = 'X';
    println(b);                     # XXXXX Xero
    w = "XX";
    println(b);                     # XX Xero

    c:  string = "AAAA BBBB";
    cv: stringview = c[5..9];
    rv: stringview = c[0..4];
    cv = rv;
    println(c);                     # AAAA AAAA
}

fn main() {
    test_string();
    test_stringview();
}
