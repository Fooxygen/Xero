
fn main() {

    for (x in 0..5) { println(x); }        # expect: 0 1 2 3 4

    for (x in 0..=5) { println(x); }       # expect: 0 1 2 3 4 5

    for (x in 0..2..8) { println(x); }     # expect: 0 2 4 6

    for (x in 1..2..=9) {
        if (x == 3 || x == 7) { continue; }
        println(x);                        # expect: 1 5 9
    }

    for (i in 0..10) {
        if (i == 4) { break; }
        println(i);                        # expect: 0 1 2 3
    }

    r: range[=i32=] = 0..2..=30;
    println(r);
    for (x in r) { println(x); }
}
