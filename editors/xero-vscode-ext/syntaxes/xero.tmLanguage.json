{
    "scopeName": "source.xero",
    "name": "Xero",
    "patterns": [
        { "include": "#comments" },
        { "include": "#special" },
        { "include": "#brackets" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#chars" },
        { "include": "#strings" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#keywords" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "include": "#blockComment" },
                { "include": "#lineComment" }
            ]
        },
        "blockComment": {
            "name": "comment.block.xero",
            "begin": "##",
            "end": "##"
        },
        "lineComment": {
            "name": "comment.line.number-sign.xero",
            "match": "#.*"
        },
        "special": {
            "name": "keyword.other.special.xero",
            "match": "@\\w+"
        },
        "brackets": {
            "name": "punctuation.bracket.generic.xero",
            "match": "\\[=|=\\]"
        },
        "numbers": {
            "name": "constant.numeric.xero",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        "booleans": {
            "name": "constant.language.boolean.xero",
            "match": "\\b(true|false)\\b"
        },
        "chars": {
            "name": "string.quoted.single.xero",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.xero",
                    "match": "\\\\."
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.xero",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.xero",
                    "match": "\\\\."
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.xero",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.assignment.xero",
                    "match": "%%=|\\+=|-=|\\*=|/=|%=|="
                },
                {
                    "name": "keyword.operator.comparison.xero",
                    "match": ">=|<=|==|!=|>|<"
                },
                {
                    "name": "keyword.operator.logical.xero",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.xero",
                    "match": "%%|%|[+\\-*/]"
                },
                {
                    "name": "keyword.operator.range.xero",
                    "match": "\\.\\.=|\\.\\."
                }
            ]
        },
        "punctuation": {
            "name": "punctuation.xero",
            "match": "[:;(){}\\[\\],.]"
        },
        "types": {
            "name": "storage.type.xero",
            "match": "\\b(bool|i32|i64|f32|f64|char|string|stringview|array|arrayview|range|none|function)\\b"
        },
        "functions": {
            "name": "support.function.builtin.xero",
            "match": "\\b(print|println|type)\\b"
        },
        "keywords": {
            "name": "keyword.control.xero",
            "match": "\\b(if|elif|else|for|while|in|break|continue|fn|return)\\b"
        }
    }
}
