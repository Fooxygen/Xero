{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Xero Debug",
            "type": "shell",
            "command": "& '${workspaceFolder}/build-debug/bin/xero.exe' '${workspaceFolder}/example/xero.project.toml'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            }
        },
        {
            "label": "Xero Release",
            "type": "shell",
            "command": "& '${workspaceFolder}/build-release/bin/xero.exe' '${workspaceFolder}/example/xero.project.toml'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            }
        },
        {
            "label": "Example Debug",
            "type": "shell",
            "command": "& '${workspaceFolder}/example/build/debug/example.exe'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            }
        },
        {
            "label": "Example Release",
            "type": "shell",
            "command": "& '${workspaceFolder}/example/build/release/example.exe'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            }
        }
    ]
}
